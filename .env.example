# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Restart `npm run dev` after any change here.

# Supabase — Settings > API in your project dashboard.
# The URL and the publishable/anon key are PUBLIC by design; they ship inside the
# JS bundle. Their safety depends entirely on the RLS policies in
# supabase_schema.sql, not on keeping them secret. See Section 8.1 of the docs.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put the service_role / secret key in this file or any VITE_ variable.
# The VITE_ prefix is exactly what tells Vite to inline a value into the public bundle.

VITE_LEAGUE_NAME="Kings County Softball League"
VITE_LEAGUE_SHORT="KCSL"
VITE_CONTACT_EMAIL=info@yourdomain.org
